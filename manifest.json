{
  "manifest_version": 3,
  "name": "note tools",
  "version": "1.2.0",
  "action": {
    "default_title": "note tools"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://note.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://note.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
